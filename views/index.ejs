<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LightDestory Apps - Privacy Policies</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/styles.css">
    <script src="/script.js" defer></script>
</head>
<body>
    <header class="top-bar">
        <a class="brand nav-link" href="/" aria-label="LightDestory Apps privacy policies home">
            <img class="brand-mark" src="/logo.png" alt="" width="36" height="36">
            <span>LightDestory Apps</span>
        </a>
        <button id="theme-toggle" class="theme-btn" type="button" aria-label="Switch to dark mode" title="Toggle color theme">
            <span class="theme-icon theme-icon-sun" aria-hidden="true">
                <i class="fa-solid fa-sun"></i>
            </span>
            <span class="theme-icon theme-icon-moon" aria-hidden="true">
                <i class="fa-solid fa-moon"></i>
            </span>
            <span class="theme-label">Dark</span>
        </button>
    </header>
    <div class="page-shell">
        <section class="container" id="app-content" aria-live="polite">
            <!-- DYNAMIC CONTENT -->
        </section>
    </div>
    <footer class="site-footer">
        <p>&copy; 2026 LightDestory</p>
    </footer>
    <button id="go-up" class="go-up-btn" type="button" aria-label="Go to top" title="Go to top">
        <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
    </button>
</body>
</html>
